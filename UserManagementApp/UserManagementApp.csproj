<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcEnableHardwareIntrinsic>true</IlcEnableHardwareIntrinsic>
    <IlcUseNewDynamicDependency>true</IlcUseNewDynamicDependency>
    <IlcStaticNativeFormat>true</IlcStaticNativeFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bootstrap" Version="5.3.8" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!--
    Trimming suppressions for ASP.NET Core MVC.
    The IL Trimmer removes types that are loaded via reflection, such as
    those used by ConsolidatedAssemblyApplicationPartFactory, which causes
    TypeLoadException at runtime. These entries keep the MVC assemblies
    that rely on dynamic type discovery.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.Razor" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.Core" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.ViewFeatures" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Mvc.TagHelpers" />
    <TrimmerRootAssembly Include="UserManagementApp" />
    <TrimmerRootAssembly Include="Npgsql" />
    <TrimmerRootAssembly Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore" />
    <TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Relational" />
    <TrimmerRootAssembly Include="MailKit" />
    <TrimmerRootAssembly Include="MimeKit" />
    <TrimmerRootAssembly Include="System.Text.Json" />
    <TrimmerRootAssembly Include="System.Text.Encodings.Web" />
    <TrimmerRootAssembly Include="System.ComponentModel.Annotations" />
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Identity" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.DependencyInjection" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.Configuration" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.Hosting" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
