@model UserManagementApp.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Error</h4>
                </div>
                <div class="card-body">
                    <p class="lead">An unexpected error has occurred.</p>
                    @if (Model.ShowRequestId)
                    {
                        <p class="text-muted">
                            Request ID: <code>@Model.RequestId</code>
                        </p>
                    }
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
                        Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
